#!/usr/bin/env bash

clear

echo "==================================="
echo "             HWID-V0.1"
echo "      HARDWARE IDENTIFICATION"
echo "==================================="
echo
echo "[+] HWID-V0.1 STARTING..."
echo

SERIAL="$(dmidecode -s system-serial-number 2>/dev/null)"

if [ -z "$SERIAL" ]; then
    SERIAL="UNKNOWN"
fi

echo "SYSTEM SERIAL NUMBER: $SERIAL"
echo
echo "[+] HWID-V0.1 STARTUP TEST COMPLETE"
echo
echo "Press ENTER to continue..."
read -r

#!/usr/bin/env bash

VERSION="V0.1.6"

clear

echo "==================================="
echo "            HWID-$VERSION"
echo "      HARDWARE IDENTIFICATION"
echo "==================================="
echo
echo "[+] HWID-$VERSION STARTING..."
echo

SERIAL="$(dmidecode -s system-serial-number 2>/dev/null)"

if [ -z "$SERIAL" ]; then
    SERIAL="UNKNOWN"
fi

REPORT="/tmp/${SERIAL}.txt"

{
    echo "==================================="
    echo "            HWID-$VERSION"
    echo "      HARDWARE IDENTIFICATION"
    echo "==================================="
    echo
    echo "SERIAL NUMBER: $SERIAL"
    echo
} > "$REPORT"

echo "SYSTEM SERIAL NUMBER: $SERIAL"
echo

echo "============== CPU ==============="
echo

echo "[+] COLLECTING CPU INFORMATION..."

{
    echo "=============== CPU ==============="
    echo 
    echo "--- CPU SUMMARY ---"
    lscpu 2>/dev/null || echo "CPU INFORMATION UNAVAILABLE"
    echo
    echo "--- DETAILED CPU INFORMATION ---"
    cat /proc/cpuinfo 2>/dev/null || echo "CPU INFORMATION UNAVAILABLE"
    echo
    echo "CPU INFORMATION COLLECTION COMPLETE"
    echo
} >> "$REPORT"

echo "[+] CPU INFORMATION COLLECTED"
echo

echo "=============== GPU ==============="
echo

echo "[+] COLLECTING GPU INFORMATION"

{
    echo "=============== GPU ==============="
    echo
    echo "--- PCI GPU DEVICES ---"

    for GPU in /sys/class/drm/card*/device; do
        if [ -d "$GPU" ]; then
            echo
            echo "GPU DEVICE: $GPU"

            [ -f "$GPU/vendor" ] && echo "PCI VENDOR ID: $(cat "$GPU/vendor")"
            [ -f "$GPU/device" ] && echo "PCI DEVICE ID: $(cat "$GPU/device")"
            [ -f "$GPU/subsystem_vendor" ] && echo "SUBSYSTEM VENDOR: $(cat "$GPU/subsystem_vendor")"
            [ -f "$GPU/subsystem_device" ] && echo "SUBSYSTEM DEVICE: $(cat "$GPU/subsystem_device")"
            [ -f "$GPU/current_link_speed" ] && echo "PCIe LINK SPEED: $(cat "$GPU/current_link_speed")"
            [ -f "$GPU/current_link_width" ] && echo "PCIe LINK WIDTH: $(cat "$GPU/current_link_width")"
            [ -f "$GPU/max_link_speed" ] && echo "MAX PCIe LINK SPEED: $(cat "$GPU/max_link_speed")"
            [ -f "$GPU/max_link_width" ] && echo "MAX PCIe LINK WIDTH: $(cat "$GPU/max_link_width")"

            if [ -L "$GPU/driver" ]; then
                echo "DRIVER: $(basename "$(readlink "$GPU/driver")")"
            fi
        fi
    done

    echo
    echo "--- DRM DEVICES ---"
    ls -la /sys/class/drm/ 2>/dev/null || true

    echo
    echo "--- PCI DETAILED INFORMATION ---"
    lspci -vv 2>/dev/null | grep -A 30 -Ei 'VGA compatible|3D controller|Display controller' \
        || echo "DETAILED GPU INFORMATION UNAVAILABLE"
    echo

    echo "GPU INFORMATION COLLECTION COMPLETE"
    echo
} >> "$REPORT"

echo "[+] GPU INFORMATION COLLECTED"
echo

echo "=============== RAM ==============="
echo

echo "[+] COLLECTING RAM INFORMATION"

{
    echo "=============== RAM ==============="
    echo

    echo "--- SYSTEM MEMORY SUMMARY ---"
    free -h 2>/dev/null || echo "MEMORY SUMMARY UNAVAILABLE"
    echo

    echo "--- MEMORY INFORMATION ---"
    cat /proc/meminfo 2>/dev/null || echo "MEMORY INFORMATION UNAVAILABLE"
    echo

    echo "--- PHYSICAL MEMORY MODULES ---"
    dmidecode -t memory 2>/dev/null || echo "PHYSICAL MEMORY INFORMATION UNAVAILABLE"
    echo    

    echo "RAM INFORMATION COLLECTION COMPLETE"
    echo
} >> "$REPORT"

echo "[+] RAM INFORMATION COLLECTED"
echo

echo "============= STORAGE ============="
echo

echo "[+] COLLECTING STORAGE INFORMATION"

{
    echo "============= STORAGE ============="
    echo

    echo "--- BLOCK DEVICES ---"
    lsblk -d -o NAME,PATH,MODEL,SERIAL,SIZE,TYPE,TRAN,ROTA,RM,RO 2>/dev/null \
        || echo "DETAILED BLOCK DEVICE INFORMATION UNAVAILABLE"
    echo

    echo "--- NVMe DEVICES ---"
    if command -v nvme >/dev/null 2>&1; then
        nvme list 2>/dev/null || echo "NO NVMe DEVICES DETECTED"
    else
        echo "NVMe TOOL UNAVAILABLE"
    fi
    echo

    echo "--- SMART INFORMATION ---"

    if command -v smartctl >/dev/null 2>&1; then
        for DEVICE in /dev/sd? /dev/nvme?n1; do
            [ -e "$DEVICE" ] || continue

            echo
            echo "SMART DEVICE: $DEVICE"
            smartctl -i "$DEVICE" 2>/dev/null || \
                echo "SMART INFORMATION UNAVAILABLE FOR $DEVICE"
        done
    else
        echo "SMART TOOL UNAVAILABLE"
    fi
    echo

    echo "--- STORAGE DEVICE INFORMATION ---"

    for DEVICE in /sys/block/*; do
        [ -e "$DEVICE" ] || continue

        NAME="$(basename "$DEVICE")"

        case "$NAME" in
            loop*|ram*|sr*|fd*)
                continue
                ;;

        esac
        echo

        echo "DEVICE /dev/$NAME"

        [ -f "$DEVICE/size" ] &&
            echo "SECTOR COUNT: $(cat "$DEVICE/size")"

        [ -f "$DEVICE/queue/logical_block_size" ] &&
            echo "LOGICAL BLOCK SIZE: $(cat "$DEVICE/queue/logical_block_size")"

        [ -f "$DEVICE/queue/physical_block_size" ] &&
            echo "PHYSICAL BLOCK SIZE: $(cat "$DEVICE/queue/physical_block_size")"

        [ -f "$DEVICE/queue/rotational" ] &&
            echo "ROTATIONAL: $(cat "$DEVICE/queue/rotational")"

        [ -f "$DEVICE/removable" ] &&
            echo "REMOVABLE: $(cat "$DEVICE/removable")"
    done
    echo

    echo "STORAGE INFORMATION COLLECTION COMPLETE"
    echo
} >> "$REPORT"

echo "[+] STORAGE INFORMATION COLLECTED"
echo

echo "============= BATTERY ============="
echo

echo "[+] COLLECTING BATTERY INFORMATION"

{
    echo "============= BATTERY ============="
    echo

    BATTERIES_FOUND=0

    echo "--- BATTERY DEVICES ---"
    echo

    for BATTERY in /sys/class/power_supply/BAT*; do
        [ -d "$BATTERY" ] || continue

        BATTERIES_FOUND=$((BATTERIES_FOUND + 1))
        NAME="$(basename "$BATTERY")"

        echo "BATTERY: $NAME"

        [ -f "$BATTERY/manufacturer" ] &&
            echo "MANUFACTURER: $(cat "$BATTERY/manufacturer")"

        [ -f "$BATTERY/model_name" ] &&
            echo "MODEL: $(cat "$BATTERY/model_name")"

        [ -f "$BATTERY/serial_number" ] &&
            echo "SERIAL NUMBER: $(cat "$BATTERY/serial_number")"

        [ -f "$BATTERY/technology" ] &&
            echo "TECHNOLOGY: $(cat "$BATTERY/technology")"

        [ -f "$BATTERY/status" ] &&
            echo "STATUS: $(cat "$BATTERY/status")"

        [ -f "$BATTERY/capacity" ] &&
            echo "CHARGE: $(cat "$BATTERY/capacity")"

        [ -f "$BATTERY/cycle_count" ] &&
            echo "CYCLE COUNT: $(cat "$BATTERY/cycle_count")"

        if [ -f "$BATTERY/energy_full_design" ]; then
            VALUE="$(cat "$BATTERY/energy_full_design") 2>/dev/null"
            [ -n "$VALUE" ] && echo "DESIGN CAPACITY: ${VALUE} µWh"
        elif [ -f "$BATTERY/charge_full_design" ]; then
            VALUE="$(cat "$BATTERY/charge_full_design") 2>/dev/null"
            [ -n "$VALUE" ] && echo "DESIGN CAPACITY: ${VALUE} µAh"
        fi

        if [ -f "$BATTERY/energy_full" ]; then
            VALUE="$(cat "$BATTERY/energy_full") 2>/dev/null"
            [ -n "$VALUE" ] && echo "FULL CHARGE CAPACITY: ${VALUE} µWh"
        elif [ -f "$BATTERY/charge_full" ]; then
            VALUE="$(cat "$BATTERY/charge_full") 2>/dev/null"
            [ -n "$VALUE" ] && echo "FULL CHARGE CAPACITY: ${VALUE} µAh"
        fi

        if [ -f "$BATTERY/energy_now" ]; then
            VALUE="$(cat "$BATTERY/energy_now") 2>/dev/null"
            [ -n "$VALUE" ] && echo "CURRENT ENERGY: ${VALUE} µWh"
        elif [ -f "$BATTERY/charge_now" ]; then
            VALUE="$(cat "$BATTERY/charge_now") 2>/dev/null"
            [ -n "$VALUE" ] && echo "CURRENT CHARGE: ${VALUE} µAh"
        fi

        if [ -f "$BATTERY/voltage_now" ]; then
            VALUE="$(cat "$BATTERY/voltage_now" 2>/dev/null)"
            [ -n "$VALUE" ] && echo "VOLTAGE: ${VALUE} µV"
        fi

        if [ -f "$BATTERY/current_now" ]; then
            VALUE="$(cat "$BATTERY/current_now") 2>/dev/null"
            [ -n "$VALUE" ] && echo "CURRENT: ${VALUE} µA"
        fi

        echo "--- RAW BATTERY PROPERTIES ---"
        cat "$BATTERY/uevent" 2>/dev/null || true
    done

    if [ "$BATTERIES_FOUND" -eq 0 ]; then
        echo "NO BATTERY DEVICES DETECTED"
    fi

    echo

    echo "BATTERY INFORMATION COLLECTION COMPLETE"
    echo
} >> "$REPORT"

echo "[+] BATTERY INFORMATION COLLECTED"
echo

echo "[+] HWID-$VERSION HARDWARE IDENTIFICATION COMPLETE" | tee -a "$REPORT"
echo
echo "Press ENTER to continue..."
read -r
